# Audio
ro.hardware.audio.primary=amazon_wrapper
ro.audiohal.has_get_capture_position=true

# Bluetooth
persist.bluetooth.bluetooth_audio_hal.disabled=true
persist.bluetooth.enablenewavrcp=false
ro.vendor.rfkilldisabled=1

# Camera
persist.vendor.camera.facing=1
persist.vendor.camera.orientation=0
ro.camera.capture_support_level=3

# Display
ro.surface_flinger.primary_display_orientation=ORIENTATION_90

# Power
ro.vendor.power.wall_powered=true

# Sensors
ro.hardware.sensors=amazon

# Wi-Fi
ro.vendor.wifi.sap.interface=ap0
wifi.interface=wlan0
